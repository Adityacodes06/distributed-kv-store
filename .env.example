# ── Node Configuration ──────────────────────────────────────
# Unique identifier for this node (e.g., node1, node2, node3)
NODE_ID=node1

# Role of this node: "leader" or "follower"
NODE_ROLE=leader

# Host and port this node listens on
NODE_HOST=0.0.0.0
NODE_PORT=8000

# ── Cluster Peers ───────────────────────────────────────────
# Comma-separated list of peer URLs (excluding self)
# Example for a 3-node cluster where this node is node1:
PEERS=http://node2:8000,http://node3:8000

# ── Leader URL (used by followers and CLI client) ───────────
LEADER_URL=http://node1:8000

# ── Storage ─────────────────────────────────────────────────
# Directory for WAL and SQLite database files
DATA_DIR=./data
